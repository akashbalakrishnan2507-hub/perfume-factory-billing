NODE_ENV=development
PORT=4000

# Database Client: 'auto' (checks MySQL, falls back to local SQLite), 'sqlite', or 'mysql'
DB_CLIENT=auto

# MySQL credentials (used when DB_CLIENT=mysql or local MySQL is detected on port 3306)
DB_HOST=localhost
DB_PORT=3306
DB_USER=perfume_app
DB_PASSWORD=change_me
DB_NAME=perfume_factory

# Security & JWT
JWT_SECRET=perfume_factory_super_secret_jwt_key_change_in_production_2024
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=http://localhost:3000
